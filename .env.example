DATABASE_URL="postgresql://user:pass@localhost:5432/antikorrupsiya"
SITE_URL="https://antikorrupsiya.uz"
NEXT_PUBLIC_SITE_TZ_OFFSET_MIN="300"      # newsroom time zone used by schedule / expiry pickers (Asia/Tashkent = 300)

# Telegram bot -> POST /api/bot/posts   (Authorization: Bearer <BOT_API_SECRET>). Posts are PUBLISHED immediately. The Telegram user id (X-Telegram-User-Id) must be in TELEGRAM_ADMIN_IDS.
BOT_AUTO_PUBLISH="0"                        # 1 = publish bot posts immediately instead of leaving them as drafts
BOT_API_SECRET="long-random-string-shared-with-the-bot"
TELEGRAM_ADMIN_IDS="123456789,987654321"

# Scheduled publishing: Vercel Cron (vercel.json) sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/publish
CRON_SECRET="another-long-random-string"

# First Super Admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-me-to-12+-chars"
SEED_DEMO="0"                              # 1 = also create three demo articles

# Uploaded images, video and PDFs are stored in the same PostgreSQL database (DATABASE_URL). No object storage is used.

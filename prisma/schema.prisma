generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lang {
  uz
  en
  ru
}

enum Format {
  NEWS
  PHOTO_NEWS
  GALLERY
  INVESTIGATION
  VIDEO
  INTERVIEW
  ANNOUNCEMENT
}

enum Status {
  DRAFT
  PENDING
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum Role {
  JOURNALIST
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum HomeKind {
  HERO
  SECONDARY
  LATEST
  POPULAR
  TRENDING
  INVESTIGATIONS
  MEDIA
  ANNOUNCEMENTS
  CATEGORY
}

// ---------- taxonomy (names / slugs / descriptions are { uz, en, ru } objects) ----------
model Category {
  id           Int           @id @default(autoincrement())
  key          String        @unique
  order        Int           @default(0)
  active       Boolean       @default(true)
  names        Json
  slugs        Json          @default("{}")
  descriptions Json          @default("{}")
  articles     Article[]
  homeSections HomeSection[]
}

model Tag {
  id       Int       @id @default(autoincrement())
  key      String    @unique
  names    Json
  slugs    Json      @default("{}")
  articles Article[]
}

// ---------- content ----------
model Article {
  id            Int                 @id @default(autoincrement())
  format        Format              @default(NEWS)
  status        Status              @default(DRAFT)
  trending      Boolean             @default(false)
  trendingOrder Int?
  expiresAt     DateTime? // announcements: hidden from public listings after this moment, never deleted
  views         Int                 @default(0)
  publishedAt   DateTime?
  submittedAt   DateTime?
  reviewNote    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  categoryId    Int?
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          Tag[]
  viewDays      ArticleView[]
  authorId      Int?
  author        User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  coverId       Int?
  cover         Media?              @relation("Cover", fields: [coverId], references: [id], onDelete: SetNull)
  images        ArticleImage[]
  translations  Translation[]
  submission    TelegramSubmission?
  homePicks     HomePick[]
  breaking      BreakingNews[]

  @@index([status, publishedAt])
  @@index([format, status])
  @@index([categoryId])
  @@index([trending, trendingOrder])
}

model Translation {
  id             Int     @id @default(autoincrement())
  articleId      Int
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lang           Lang
  slug           String
  title          String
  description    String  @default("")
  blocks         Json // TipTap document (paragraph, heading, list, quote, link, divider, image, gallery, video, document, table)
  seoTitle       String?
  seoDescription String?

  @@unique([lang, slug])
  @@unique([articleId, lang])
  @@index([lang])
}

// Media metadata. The file bytes live in MediaFile (one row per Media) so that listing and joining media never loads binary data.
model Media {
  id           Int            @id @default(autoincrement())
  publicId     String         @unique @default(uuid()) // unguessable id used in the public URL: /api/media/<publicId>.<ext>
  kind         MediaKind      @default(IMAGE)
  filename     String         @default("")
  path         String         @unique // public URL served from PostgreSQL by GET /api/media/<publicId>.<ext>
  mime         String
  size         Int
  width        Int?
  height       Int?
  sha256       String?        @unique // identical bytes are stored once and reused
  alt          String?
  caption      String?
  credit       String?
  uploadedById Int?
  uploadedBy   User?          @relation("Uploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  file         MediaFile?
  covers       Article[]      @relation("Cover")
  uses         ArticleImage[]

  @@index([kind, createdAt])
}

// Binary contents of an uploaded file (BYTEA in PostgreSQL).
model MediaFile {
  mediaId Int   @id
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  data    Bytes
}

// Ordered photo album of an article (Telegram albums and gallery-format articles)
model ArticleImage {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int

  @@index([articleId, position])
}

model TelegramSubmission {
  id             Int      @id @default(autoincrement())
  idempotencyKey String?  @unique
  articleId      Int      @unique
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  originalText   String
  mediaGroupId   String?
  status         String   @default("RECEIVED") // RECEIVED | DRAFTED | PUBLISHED | REJECTED
  receivedAt     DateTime @default(now())

  @@index([status, receivedAt])
}

// ---------- staff ----------
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(JOURNALIST)
  canPublish   Boolean   @default(false) // explicit authorisation for a Journalist to publish own articles
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  activity     Activity[]
  articles     Article[]
  uploads      Media[]   @relation("Uploads")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  articleId Int? // no foreign key on purpose: the log must survive article deletion
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([articleId])
  @@index([userId])
}

// ---------- analytics ----------
model ArticleView {
  id        Int      @id @default(autoincrement())
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  count     Int      @default(0)

  @@unique([articleId, day])
  @@index([day])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ---------- front page ----------
model BreakingNews {
  id        Int       @id @default(autoincrement())
  text      String
  lang      Lang
  articleId Int?
  article   Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([lang, active])
}

model HomeSection {
  id         Int        @id @default(autoincrement())
  kind       HomeKind
  categoryId Int?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)
  count      Int        @default(6)
  manual     Boolean    @default(false) // true: show the editor's picks; false: automatic selection
  picks      HomePick[]

  @@unique([kind, categoryId])
}

model HomePick {
  id        Int         @id @default(autoincrement())
  sectionId Int
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  articleId Int
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([sectionId, articleId])
  @@index([sectionId, position])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
